; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="hypear"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/main_scene="res://scenes/game/game.tscn"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/size/viewport_width=960
window/size/viewport_height=720

[input]

sort_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194319)]
}

sort_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194321)]
}

ship_boxes={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194322)]
}

start_game={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194309), Object(InputEventKey,"physical_keycode":32)]
}

toggle_weights={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":68)]
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

environment/defaults/default_clear_color=Color(0.07, 0.12, 0.17, 1)
